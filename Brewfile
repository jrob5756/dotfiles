# Native macOS apps and fonts this configuration depends on. Additive:
# `brew bundle` installs what is missing and never removes anything else.

# Home Manager owns its config but not the signed app.
cask "ghostty"

# Terminal font and icon fallback set in modules/ghostty.nix.
cask "font-jetbrains-mono-nerd-font"
cask "font-symbols-only-nerd-font"

# Dev tunnels client for reaching remote machines over SSH.
cask "devtunnel"
